  "Invariants" : [
    {
      "context" : "Truck",
      "invs" : [
        {
          "name" : "TypeCheck",
          "expr" : "self.type >= 4 and self.type <=6",
          "satisfied" : true,
          "violated" : []
        },
        {
          "name" : "ValidWeight",
          "expr" : "self.weight > 0",
          "satisfied" : true,
          "violated" : []
        },
        {
          "name" : "ValidPayloadCapacity",
          "expr" : "self.payloadCapacity > 0",
          "satisfied" : true,
          "violated" : []
        }
      ]
    },
    {
      "context" : "OBU",
      "invs" : [
        {
          "name" : "BatteryLevel",
          "expr" : "self.batteryLevel >= 5",
          "satisfied" : true,
          "violated" : []
        }
      ]
    },
    {
      "context" : "PassRecord",
      "invs" : [
        {
          "name" : "TruckCheck",
          "expr" : "self.plate = self.belongsTo.assignedTo.plate",
          "satisfied" : true,
          "violated" : []
        },
        {
          "name" : "WeightChange",
          "expr" : "self.passWeight = self.containedBy.entranceWeight",
          "satisfied" : false,
          "violated" : [10,11]
        },
        {
          "name" : "OverSpeed",
          "expr" : "self.speed <= self.createdBy.installedOn.maxSpeedLimit",
          "satisfied" : true,
          "violated" : []
        }
      ]
    },
    {
      "context" : "Trip",
      "invs" : [
        {
          "name" : "OverLoad",
          "expr" : "self.contains->forAll(r | r.passWeight <= r.belongsTo.assignedTo.weight + r.belongsTo.assignedTo.payloadCapacity) ",
          "satisfied" : true,
          "violated" : []
        },
        {
          "name" : "WeightChange",
          "expr" : "self.contains->forAll(r | r.passWeight = self.entranceWeight)",
          "satisfied" : false,
          "violated" : [3]
        },
        {
          "name" : "TollCheck",
          "expr" : "self.status = 1 implies self.totalToll = self.contains->collect(createdBy)->collect(toll)->sum()",
          "satisfied" : true,
          "violated" : []
        },
        {
          "name" : "StatusCheck",
          "expr" : "self.status = 1 or self.status = 0 or self.status = -1",
          "satisfied" : true,
          "violated" : []
        },
        {
          "name" : "HasEntryAndExit",
          "expr" : "self.contains->collect(createdBy)->collect(type)->includes('Entry') and self.contains->collect(createdBy)->collect(type)->includes('Exit')",
          "satisfied" : true,
          "violated" : []
        },
        {
          "name" : "EntryAndExitDiff",
          "expr" : "self.contains->collect(createdBy)->select(d | d.type='Entry' or d.type='Exit')->isUnique(type)",
          "satisfied" : true,
          "violated" : []
        }
      ]
    },
    {
      "context" : "RoadSideDevice",
      "invs" : [
        {
          "name" : "StatusCheck",
          "expr" : "self.isClosed implies self.generated->isEmpty()",
          "satisfied" : true,
          "violated" : []
        },
        {
          "name" : "TypeCheck",
          "expr" : "self.type = 'Entry' or self.type = 'Gantry' or self.type = 'Exit'",
          "satisfied" : true,
          "violated" : []
        }
      ]
    },
    {
      "context" : "Road",
      "invs" : [
        {
          "name" : "SpeedLimit",
          "expr" : "self.minSpeedLimit < self.maxSpeedLimit",
          "satisfied" : true,
          "violated" : []
        }
      ]
    }
  ]
